<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='hr_attendance']" position="inside">
                <h2>Attendance Report Automated Creation Controls</h2>
                <div class="row mt16 o_settings_container" name="attendance_report_autocreation">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label string="Period for attendances reports" for="attendance_report_autocreation_period"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    This will select how the reports are created, there are tree options: monthly, quarterly and yearly.
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="attendance_report_autocreation_period" class="o_light_label" widget="selection" required="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label string="Company Contact" for="company_partner_to_send_id"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    This will select to where would you send the report on creation and when it's signed, per company.
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="company_partner_to_send_id" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label string="Global contact" for="partner_to_send_id"/>
                            <div class="row">
                                <div class="text-muted col-lg-8">
                                    This will select to where would you send the report on creation and when it's signed, globaly.
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="partner_to_send_id" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
