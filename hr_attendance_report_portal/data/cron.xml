<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_create_attendance_reports" model="ir.cron">
        <field name="name">Search employees to create attendance reports</field>
        <field eval="True" name="active"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(datetime.now().replace(day=15) + relativedelta(months=1)).strftime('%Y-%m-%d 00:00:00')" />
        <field eval="False" name="doall"/>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="code">model._create_attendance_report()</field>
        <field name="state">code</field>
    </record>
</odoo>
