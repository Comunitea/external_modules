<?xml version="1.0" ?>
<odoo>

    <record id="view_account_move_line_filter" model="ir.ui.view">
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="analytic_account_ids" groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_add_partial_filter" model="ir.ui.view">
        <field name="name">account.invoice.select</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="open" position="after">
                <filter name="partial" string="Partially Paid" domain="[('state', '=', 'posted'), ('payment_state', '=', 'partial')]"/>
            </filter>
        </field>
    </record>

</odoo>
