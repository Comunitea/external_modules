<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_inherit_hr_attendance" model="ir.ui.view">
        <field name="name">res.users.form.inherit.hr.attendance</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="partner_firstname.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='firstname']/.." position="after">
                <group>
                    <field name="allow_remote_check_in"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
