<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='pincode_setting_container']" position="after">
                <div class="row mt16 o_settings_container" name="ips_allowed_for_check_in_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="ips_allowed_for_check_in"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." role="img" aria-label="Values set here are company-specific." groups="base.group_multi_company"/>
                            <div class="row">
                                <div class="text-muted col-lg-10">
                                    List of IPs or IP ranges allowed for employees to check in/out. One per line. Need to be a regular expression.
                                </div>
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="ips_allowed_for_check_in" widget="textarea" class="o_settings_textarea"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
