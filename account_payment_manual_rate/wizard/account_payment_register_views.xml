<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form - account_payment_manual_rate</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='amount_div']" position="after">
                <field name="manual_rate_available" invisible="1" />
                <field name="use_manual_rate" invisible="1" />
                <label for="manual_rate" invisible="not manual_rate_available" />
                <div
                    name="manual_rate_div"
                    class="o_row"
                    invisible="not manual_rate_available"
                >
                    <span>1</span>
                    <field
                        name="manual_rate_base_currency_id"
                        readonly="1"
                        options="{'no_open': True}"
                        class="w-auto"
                    />
                    <span>=</span>
                    <field
                        name="manual_rate"
                        digits="[12, 6]"
                        class="oe_inline"
                    />
                    <field
                        name="manual_rate_currency_id"
                        readonly="1"
                        options="{'no_open': True}"
                        class="w-auto"
                    />
                    <button
                        type="object"
                        name="action_refresh_manual_rate"
                        icon="fa-refresh"
                        title="Reset the rate to the one defined in the system"
                        class="btn btn-link p-0"
                        invisible="not use_manual_rate"
                    />
                </div>
                <label for="manual_inverse_rate" invisible="not manual_rate_available" />
                <div
                    name="manual_inverse_rate_div"
                    class="o_row"
                    invisible="not manual_rate_available"
                >
                    <span>1</span>
                    <field
                        name="manual_rate_currency_id"
                        readonly="1"
                        options="{'no_open': True}"
                        class="w-auto"
                    />
                    <span>=</span>
                    <field
                        name="manual_inverse_rate"
                        digits="[12, 6]"
                        class="oe_inline"
                    />
                    <field
                        name="manual_rate_base_currency_id"
                        readonly="1"
                        options="{'no_open': True}"
                        class="w-auto"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
