<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.stock.custom</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="70"/>
            <field name="inherit_id" ref="stock.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='group_stock_production_lot']" position="inside">
                    <div class="row mt-2" invisible="not group_stock_production_lot">
                        <field name="serial_to_upper_case" class="col flex-grow-0 ml16 mr0 pe-2"/>
                        <div class="col ps-0">
                            <label for="serial_to_upper_case"/>
                            <div class="text-muted"> Convert all serial numbers to upper case.</div>
                        </div>
                    </div>
                </xpath>

            </field>
        </record>
</odoo>