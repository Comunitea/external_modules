<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<record id="view_move_form" model="ir.ui.view">
        <field name="name">Stock Move Alternative Tracking</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_serials"
                    string="Series/Lotes"
                    type="object"
                    icon="fa-barcode"
                />
            </xpath>
        </field>
    </record>
     <record id="view_stock_move_operations" model="ir.ui.view">
            <field name="name">stock.move.operations.form</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_stock_move_operations" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_line_ids']" position="after">
                    <field name="template_tracking" attrs="{'invisible': [('template_tracking', '!=', 'virtual')]}" />
                    <field name="serial_ids" widget="many2many_tags" attrs="{'invisible': ['|', ('serial_ids', '=', False), ('template_tracking', '!=', 'virtual')]}" />
                </xpath>
                
            </field>
        </record>
</odoo>