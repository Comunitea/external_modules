<?xml version="1.0" encoding="utf-8" ?>
<data>
    <!-- Wizard view to stop work -->
    <record id="hr_timesheet_stop_popup_form" model="ir.ui.view">
        <field name="name">hr.timesheet.stop.form</field>
        <field name="model">hr.timesheet.stop.popup</field>
        <field name="inherit_id" />
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title" modifiers="{}">
                        <label class="oe_edit_only" for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group colspan="4">
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="analytic_line_ids" widget="manay2many" invisible="1"/>
                    </group>
                </sheet>
                <!-- Footer buttons -->
                <footer>
                    <button
                        name="action_save"
                        type="object"
                        string="Stop timer"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</data>
